<Window x:Class="ZapretUi.ConfirmServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zapret" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,18,22,18">
    <TextBlock x:Name="DlgHeading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="DlgText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/>
    <CheckBox x:Name="DlgDontAsk" Content="Больше не показывать" Margin="0,16,0,0"/>
    <TextBlock x:Name="DlgHint"
               Margin="20,3,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="DlgOk" Style="{StaticResource Primary}" IsDefault="True"/>
      <Button Content="Отмена" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
