<Window x:Class="ZapretUi.ChecklistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" SizeToContent="Height" MaxHeight="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,18,22,18">
    <TextBlock x:Name="DlgTitle" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="DlgFrom" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"/>
    <StackPanel x:Name="Items"/>
    <TextBlock x:Name="DlgNote" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="DlgOk" Style="{StaticResource Primary}" Tag="&#xE8B5;" IsDefault="True"/>
      <Button Content="Отмена" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
