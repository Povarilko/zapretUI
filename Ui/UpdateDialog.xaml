<Window x:Class="ZapretUi.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление zapret" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,18,22,18">
    <TextBlock x:Name="DlgTitle" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="DlgText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}"
               Text="«Обновить» скачает новую версию с GitHub в отдельную папку рядом с этой, перенесёт туда ваши списки, историю и настройки, переустановит службу и откроет окно уже из новой папки. Эта папка останется как есть — на случай отката."/>
    <CheckBox x:Name="DlgSkip" Content="Не напоминать об этой версии" Margin="0,16,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="DlgUpdate" Style="{StaticResource Primary}" Tag="&#xE896;" Content="Обновить" IsDefault="True"/>
      <Button x:Name="DlgOpen" Tag="&#xE774;" Content="Страница загрузки"/>
      <Button Content="Позже" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
