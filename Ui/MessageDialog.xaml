<Window x:Class="ZapretUi.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zapret" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,20,22,18">
    <DockPanel>
      <TextBlock x:Name="MsgIcon" FontFamily="{StaticResource IconFont}" FontSize="22" VerticalAlignment="Top" Margin="0,0,14,0"/>
      <TextBlock x:Name="MsgText" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19"/>
    </DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="MsgYes" Style="{StaticResource Primary}" IsDefault="True" MinWidth="80"/>
      <Button x:Name="MsgNo" IsCancel="True" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</Window>
