<Window x:Class="ZapretUi.TargetsEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки теста" Width="760" Height="620" MinWidth="640" MinHeight="460" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <DockPanel Margin="18,16,18,14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Что проверяет тест" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                 Text="Каждая группа — колонка в таблице результатов. Сайт (discord.com или https://…) проверяется по HTTP, TLS 1.2, TLS 1.3 и пингу, IP-адрес — только пингом."/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="BtnDefaults" DockPanel.Dock="Left" Tag="&#xE777;" Content="Вернуть стандартные" Margin="0"/>
      <Button x:Name="BtnImportTargets" DockPanel.Dock="Left" Tag="&#xE8B5;" Content="Импорт" ToolTip="Добавить группы и адреса из файла: настроек теста (targets.txt) или простого списка адресов"/>
      <Button x:Name="BtnExportTargets" DockPanel.Dock="Left" Tag="&#xEDE1;" Content="Экспорт" ToolTip="Сохранить выбранные группы и адреса в файл в формате targets.txt"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnSave" Style="{StaticResource Primary}" Tag="&#xE74E;" Content="Сохранить" IsDefault="False"/>
        <Button Content="Отмена" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
    <TextBlock x:Name="TxtErr" DockPanel.Dock="Bottom" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Группы" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0,0,6"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnAddGroup" Tag="&#xE710;" Content="Группа" Margin="0" ToolTip="Добавить группу"/>
            <Button x:Name="BtnUp" Tag="&#xE74A;" Padding="8,0" ToolTip="Выше"/>
            <Button x:Name="BtnDown" Tag="&#xE74B;" Padding="8,0" ToolTip="Ниже"/>
          </StackPanel>
          <ListBox x:Name="LbGroups"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
        <DockPanel x:Name="GroupPane">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Название группы" Foreground="{DynamicResource Muted}" FontSize="12"/>
            <DockPanel Margin="0,4,0,14">
              <Button x:Name="BtnDelGroup" DockPanel.Dock="Right" Tag="&#xE74D;" Content="Удалить группу"/>
              <TextBox x:Name="TbGroupName" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
              <TextBlock x:Name="TxtAddrCount" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12"/>
              <TextBlock Text="Адреса — по одному на строку" Foreground="{DynamicResource Muted}" FontSize="12"/>
            </DockPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock x:Name="TxtAddrCheck" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Сайт — discord.com или https://discord.com/app, проверяется по HTTP, TLS и пингу. IP-адрес — 8.8.8.8, только пинг. Пустые строки не считаются."/>
          </StackPanel>
          <TextBox x:Name="TbAddrs" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                   Padding="6,6" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
