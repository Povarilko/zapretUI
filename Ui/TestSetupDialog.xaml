<Window x:Class="ZapretUi.TestSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тест стратегий" Width="520" Height="600" MinHeight="400" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <DockPanel Margin="22,18,22,16">
    <TextBlock DockPanel.Dock="Top" Text="Тест стратегий" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock DockPanel.Dock="Top" Text="Тип теста" Foreground="{DynamicResource Muted}" Margin="0,12,0,6"/>
    <RadioButton DockPanel.Dock="Top" x:Name="RbStandard" IsChecked="True" Content="Обычный: открываются ли сайты (HTTP, TLS 1.2 и 1.3) и пинг"/>
    <RadioButton DockPanel.Dock="Top" x:Name="RbDpi" Margin="0,6,0,0" Content="DPI: не обрывается ли соединение на 16–20 КБ (дольше)"/>
    <RadioButton DockPanel.Dock="Top" x:Name="RbCombined" Margin="0,6,0,0" Content="Комбинированный: обычный и DPI подряд, общий итог (дольше всего)"/>
    <CheckBox DockPanel.Dock="Top" x:Name="ChkBaseline" Margin="0,16,0,0">
      <TextBlock x:Name="TxtBaseline" Text="Ещё проверить без обхода"/>
    </CheckBox>
    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="28,2,0,0"
               Text="Те же проверки с выключенным zapret: видно, что у провайдера заблокировано на самом деле и что даёт каждая стратегия. В таблице — строка «Без обхода»."/>
    <DockPanel DockPanel.Dock="Top" Margin="0,16,0,6">
      <TextBlock x:Name="TxtSelCount" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnSelAll" Content="Выбрать все" Height="28"/>
        <Button x:Name="BtnSelNone" Content="Снять все" Height="28"/>
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="BtnGo" Style="{StaticResource Primary}" Tag="&#xE768;" Content="Запустить тест" IsDefault="True"/>
      <Button Content="Отмена" IsCancel="True"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="TxtEstimate" FontSize="12" Margin="0,8,0,0"/>
    <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
               Text="Тест по очереди запускает выбранные стратегии, поэтому обход и интернет через zapret будут ненадолго пропадать. Результат каждой стратегии сразу появится в таблице."/>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SetupList" Margin="10,6"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
