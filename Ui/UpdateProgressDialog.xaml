<Window x:Class="ZapretUi.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление zapret" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,18,22,18">
    <TextBlock x:Name="UpTitle" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="UpStep" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <ProgressBar x:Name="UpBar" Margin="0,12,0,0" Maximum="100"/>
    <TextBlock x:Name="UpErr" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Bad}" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="UpCancel" Content="Отмена"/>
    </StackPanel>
  </StackPanel>
</Window>
