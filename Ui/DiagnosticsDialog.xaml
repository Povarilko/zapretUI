<Window x:Class="ZapretUi.DiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,18,22,18">
    <TextBlock Text="Диагностика" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="DlgSummary" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,12"/>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SurfaceAlt}">
      <ScrollViewer x:Name="RowsScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Rows" Margin="12,7"/>
      </ScrollViewer>
    </Border>
    <Border x:Name="ConflictBox" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="BtnConflicts" DockPanel.Dock="Right" Tag="&#xE74D;" Content="Удалить службы" VerticalAlignment="Center"/>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Другие обходы" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtConflicts" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <DockPanel>
        <Button x:Name="BtnDiscord" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="&#xE74D;" Content="Очистить кэш" VerticalAlignment="Center"/>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Кэш Discord" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtDiscord" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnRecheck" Tag="&#xE72C;" Content="Проверить снова"/>
      <Button Content="Закрыть" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
