<Window x:Class="ZapretUi.InstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zapret" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <StackPanel Margin="22,18,22,18">
    <TextBlock Text="zapret не найден" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Это окно — только оболочка для zapret-discord-youtube, а рядом с ним нет самого zapret (service.bat и папки bin). Его можно скачать отсюда: последняя версия с GitHub Flowseal/zapret-discord-youtube."/>
    <TextBlock x:Name="InsVersion" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="Последняя версия: проверяю…"/>
    <TextBlock Text="Папка установки" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,4"/>
    <DockPanel>
      <Button x:Name="InsBrowse" DockPanel.Dock="Right" Tag="&#xE8DA;" Content="Изменить"/>
      <TextBox x:Name="InsPath" IsReadOnly="True" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="InsNote" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    <DockPanel Margin="0,18,0,0">
      <Button x:Name="InsExisting" DockPanel.Dock="Left" Tag="&#xE8B7;" Content="У меня уже есть zapret" Margin="0"
              ToolTip="Указать service.bat в папке zapret: окно переедет туда и откроется оттуда"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="InsInstall" Style="{StaticResource Primary}" Tag="&#xE896;" IsDefault="True"/>
        <Button Content="Закрыть" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
