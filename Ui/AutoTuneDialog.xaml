<Window x:Class="ZapretUi.AutoTuneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подбор стратегии" Width="560" Height="640" MinHeight="480" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <DockPanel Margin="18,16,18,14">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Подбор стратегии" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                 Text="Окно соберёт конфиг из стоковых стратегий Flowseal: прогонит их обычным тестом, возьмёт лучшую за основу и переберёт варианты её настроек (метод, fooling, повторы, позиция сплита). Кастомные стратегии можно исключить галочками. Займёт ~10–20 минут, обход будет переключаться между конфигурациями."/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnClose" Content="Закрыть" IsCancel="True" Margin="0"/>
      <Button x:Name="BtnSave" Style="{StaticResource Primary}" Tag="&#xE74E;" Content="Сохранить custom (AUTO)" Visibility="Collapsed"/>
      <Button x:Name="BtnStart" Style="{StaticResource Primary}" Tag="&#xE768;" Content="Начать подбор" Margin="0,0,6,0"/>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10" x:Name="StrategiesCard">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Стратегии для предтеста" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,0,0,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
            <StackPanel x:Name="StrategyList"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" x:Name="PhaseText" Text="Ожидание запуска" FontWeight="SemiBold"/>
          <ProgressBar DockPanel.Dock="Top" x:Name="Progress" Margin="0,8,0,8"/>
          <TextBox x:Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                   VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAlt}" Padding="6"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
