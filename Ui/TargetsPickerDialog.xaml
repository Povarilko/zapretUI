<Window x:Class="ZapretUi.TargetsPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="560" MinHeight="360" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}">
  <DockPanel Margin="22,18,22,16">
    <TextBlock x:Name="PkTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="PkSub" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <TextBlock x:Name="PkCount" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PkAll" Content="Выбрать все" Height="28"/>
        <Button x:Name="PkNone" Content="Снять все" Height="28"/>
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="PkOk" Style="{StaticResource Primary}" IsDefault="True"/>
      <Button Content="Отмена" IsCancel="True"/>
    </StackPanel>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PkList" Margin="6,4"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
